# Server Configuration
PORT=5001

# PostgreSQL Database Configuration
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://USERNAME@localhost:5432/api_sentinel?schema=public"

# Redis Queue Configuration (Docker)
REDIS_URL="redis://localhost:6379"

# NVIDIA AI Diagnostics Configuration
NVIDIA_API_KEY="your-nvidia-api-key-here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
